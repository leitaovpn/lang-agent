# deepseek provider 的 API key（ai 层从环境变量读取）
DEEPSEEK_API_KEY=sk-xxx
# 可选：覆盖 deepseek 默认 base_url
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# agent 层默认参数
# LANG_AGENT_MODEL=deepseek-v4-flash
# LANG_AGENT_PROVIDER=deepseek
# LANG_AGENT_PROTOCOL=chat_response
# LANG_AGENT_CHECKPOINTER=sqlite
# LANG_AGENT_DB_PATH=~/.lang-agent/checkpoints.sqlite
# LANG_AGENT_HOST=127.0.0.1
# LANG_AGENT_PORT=8000
